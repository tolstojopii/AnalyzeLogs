// use prisma-8

model Log {
  id        Int      @id @default(autoincrement())
  timestamp String 
  level     String
  service   String
  message   String
  trace     String   @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([timestamp])
  @@index([service])
  @@index([level])
}

